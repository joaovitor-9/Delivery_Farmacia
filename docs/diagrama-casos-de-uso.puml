@startuml
left to right direction

skinparam packageStyle rectangle

actor "Cliente" as cliente
actor "Funcionário (Admin)" as admin

rectangle "Sistema Delivery de Farmácia" {
    usecase "Realizar Pedido" as UC1
    usecase "Gerenciar Carrinho" as UC2
    usecase "Buscar Produtos" as UC3
    usecase "Acompanhar Status" as UC4
    usecase "Atualizar Status do Pedido" as UC5
    usecase "Visualizar Painel de Pedidos" as UC6
}

cliente --> UC1
cliente --> UC2
cliente --> UC3
cliente --> UC4

admin --> UC5
admin --> UC6

@enduml